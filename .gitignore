# ==========================================
# Python Virtual Environments
# ==========================================
.venv/
venv/
ENV/
env/

# ==========================================
# Byte-compiled / Cache files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ==========================================
# Secrets, Keys & Environment Variables
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
secrets/
credentials*.json
token*.json

# ==========================================
# Heavy Data & Model Artifacts
# ==========================================
*.parquet
*.arrow
*.db
*.sqlite
*.sqlite3
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.h5
*.ckpt
*.joblib
*.pkl

# Data directories (preserve .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Artifacts directory (preserve .gitkeep)
artifacts/*
!artifacts/.gitkeep

# ==========================================
# Worktrees & Agent Internal Tooling
# ==========================================
.worktrees/
.superpowers/

# ==========================================
# Logs & IDE / OS artifacts
# ==========================================
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
